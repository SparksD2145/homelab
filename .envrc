use nix

#shellcheck disable=SC2148,SC2155

# Kubernetes
export KUBECONFIG=$(expand_path ./provision/kubeconfig)

# Ansible
export ANSIBLE_CONFIG=$(expand_path ./ansible.cfg)
export ANSIBLE_HOST_KEY_CHECKING="False"
export PLAYS=$(expand_path ./provision/ansible/playbooks)

# Sops
export SOPS_AGE_KEY_FILE=$(expand_path ~/.config/sops/age/keys.txt)
export GPG_TTY=$(tty)

# Restic
export RESTIC_REPO_BASE="s3:http://backups.sparks.codes:3900/default-bucket"
export AWS_ACCESS_KEY_ID=$(sops decrypt cluster/core/storage/backup/volsync/restic-defaults.sops.yaml | yq -r '.stringData.AWS_ACCESS_KEY_ID')
export AWS_SECRET_ACCESS_KEY=$(sops decrypt cluster/core/storage/backup/volsync/restic-defaults.sops.yaml | yq -r '.stringData.AWS_SECRET_ACCESS_KEY')
export RESTIC_PASSWORD=$(sops decrypt cluster/core/storage/backup/volsync/restic-defaults.sops.yaml | yq -r '.stringData.RESTIC_PASSWORD')
